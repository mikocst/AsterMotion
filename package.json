{
  "name": "astermotion",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "main": "./lib-dist/index.cjs",
  "module": "./lib-dist/index.js",
  "types": "./lib-dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib-dist/index.d.ts",
      "import": "./lib-dist/index.js",
      "require": "./lib-dist/index.cjs"
    },
    "./style.css": "./lib-dist/style.css"
  },
  "files": [
    "lib-dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "build:lib": "tsup && npm run build:lib:css",
    "build:lib:css": "tailwindcss -c tailwind.lib.config.cjs -i ./src/styles/tailwind.lib.css -o ./lib-dist/style.css --minify",
    "prepublishOnly": "npm run build:lib"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "motion": "^12.23.24"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.7",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.4.8",
    "clsx": "^2.1.1",
    "lucide-react": "^0.556.0",
    "motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  }
}
